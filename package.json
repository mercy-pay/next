{
  "name": "@mercy-pay/next",
  "version": "0.2.0",
  "description": "Mercy Pay pour Next.js : recevoir les webhooks signés dans une route de l'App Router.",
  "keywords": [
    "mercy pay",
    "next.js",
    "webhooks",
    "paiement",
    "mobile money"
  ],
  "homepage": "https://docs.mercy-pay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mercy-pay/next.git"
  },
  "bugs": "https://github.com/mercy-pay/next/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mercy-pay/node": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
